# Backend environment — copy to .env

# Database (Postgres 16 + TimescaleDB + PostGIS)
DATABASE_URL=postgresql+psycopg://oceansx_app:changeme_app@localhost:5432/oceansx

# MPA OceansX API
OCEANSX_BASE_URL=https://oceans-x.mpa.gov.sg
OCEANSX_API_KEY=
OCEANSX_MOCK_MODE=auto

# Anthropic
ANTHROPIC_API_KEY=

# Admin
ADMIN_TOKEN=changeme_admin_token

# RSS.app webhooks (HMAC secrets per feed)
RSS_APP_FEED_1_HMAC=
RSS_APP_FEED_2_HMAC=
RSS_APP_FEED_3_HMAC=

# Timezone
DISPLAY_TIMEZONE=America/Chicago

# Server
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
